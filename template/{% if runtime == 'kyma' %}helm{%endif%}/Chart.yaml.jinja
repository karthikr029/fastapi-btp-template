---
apiVersion: v2
name: {% include pathjoin('includes', 'name-slug.jinja') %}
description: {{description}}
type: application
version: 1.0.0
appVersion: 1.0.0
annotations:
  app.kubernetes.io/managed-by: {{ '{{ .Release.Namespace }}' }}
dependencies:
  - name: web-application
    alias: srv
    version: ">0.0.0"
  - name: service-instance
    alias: xsuaa
    version: ">0.0.0"
  {% if hana %}- name: service-instance
    alias: hana
    version: ">0.0.0"
  {% endif %}{% if destination == 'internet' or destination == 'onprem' %}- name: service-instance
    alias: destination
    version: ">0.0.0"
  {% endif %}